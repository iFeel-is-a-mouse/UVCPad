<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- [uvcpad-keybar-font] 按键栏按钮统一样式：高度交由 wrap_content + 统一字号行高决定
         （字号一致 → 行高一致 → 按钮自然等高），不再固定 40dp。
         字号不进 style —— 6 个按钮在 layout 中统一 14sp。
         singleLine：蓝牙设备名过长时单行省略（配合按钮自身的 ellipsize="end"）。 -->
    <style name="KeyBarButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Theme.Uvcpad" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
