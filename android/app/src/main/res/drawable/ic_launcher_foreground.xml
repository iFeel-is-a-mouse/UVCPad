<?xml version="1.0" encoding="utf-8"?>
<!-- uvcpad launcher foreground (tablet theme, M2): a simple tablet silhouette —
     white rounded-rectangle bezel + cyan screen + white home indicator + a small
     "touch" dot on the screen (transparent touchpad hint). All geometry stays inside
     the adaptive-icon safe zone (center 54,54, radius 33) so no part gets clipped. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Tablet bezel (white rounded rect): 40,32 → 68,76, corner radius 4 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,32h28a4,4 0 0 1 4,4v36a4,4 0 0 1 -4,4h-28a4,4 0 0 1 -4,-4v-36a4,4 0 0 1 4,-4z" />
    <!-- Screen (cyan rounded rect): 44,36 → 64,70, corner radius 2 -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M44,36h20a2,2 0 0 1 2,2v32a2,2 0 0 1 -2,2h-20a2,2 0 0 1 -2,-2v-32a2,2 0 0 1 2,-2z" />
    <!-- Home indicator (white pill at screen bottom): 50,64 → 58,66, corner radius 1 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,64h8a1,1 0 0 1 1,1a1,1 0 0 1 -1,1h-8a1,1 0 0 1 -1,-1a1,1 0 0 1 1,-1z" />
    <!-- Touch dot (small white circle on the screen, center 54,52, r=2.5): hints the transparent touchpad -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,49.5a2.5,2.5 0 1 1 0,5a2.5,2.5 0 1 1 0,-5z" />
</vector>
