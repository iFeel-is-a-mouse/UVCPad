<?xml version="1.0" encoding="utf-8"?>
<!-- uvcpad M2 layout (DESIGN §3.1):
     Z order (bottom→top): cameraViewContainer (UVC frame) → touchLayer (touch layer, aligned to the display area at runtime)
     → topUiContainer (drop triangle + key bar, M2 interaction entry) → errorText (error message, visible only on errors).
     [uvcpad-touch-align]: touchLayer no longer fills the whole screen — MainActivity shrinks its bounds to the actual
     display rectangle of AspectRatioTextureView on every layout change (display area = rectangle actually occupied by the frame, DESIGN §3.2). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- UVC camera render container (full screen; CameraActivity adds the render view automatically) -->
    <FrameLayout
        android:id="@+id/cameraViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Touch layer: draws nothing, only receives touch events and forwards them to ViewListener (gestures mounted after Bluetooth connects).
         Sits above cameraViewContainer → touches inside the display area are dispatched to this layer first.
         [uvcpad-touch-align]: keeps a full-screen placeholder in XML; MainActivity shrinks this layer to AspectRatioTextureView's
         display rectangle on every layout change (first layout / resolution switch / rotation rebuild); touches outside the
         display area (black bars/letterbox) land on the non-clickable cameraViewContainer and are dropped by the framework,
         producing no HID events. Gestures are unmounted when Bluetooth disconnects (DESIGN §3.2).
         Note: this layer must NOT go inside cameraViewContainer — AUSBC initView() calls removeAllViews(), clearing all
         XML child views in the container (confirmed in AUSBC 3.6.0 source, DESIGN §3.2). -->
    <com.github.ifeel.uvcpad.touch.TransparentTouchLayer
        android:id="@+id/touchLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- M2: top interaction area (DESIGN §3.1) — the only always-visible UI: drop triangle + auto-hiding key bar.
         Z order above the touch layer: events inside the triangle/key-bar bounds are dispatched to this area first and do not
         penetrate the touch gesture layer (M2 acceptance key: tapping the triangle/menu buttons produces no mouse reports,
         DESIGN §3.3/§3.4).
         Triangle on top (later XML view is dispatched first): the triangle stays visible and clickable (toggle to collapse)
         while the key bar is expanded. -->
    <FrameLayout
        android:id="@+id/topUiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <!-- Key bar: horizontal top bar (following the hdmi2mp topOverlay style), slides out from the top, GONE by default;
             KeyBarController controls show/hide and 4s auto-hide; area event consumption (DESIGN §3.4).
             The button set contains no keyboard settings items (Q2 ✅): speed / Bluetooth / auto-pair / resolution / screenshot / exit. -->
        <com.github.ifeel.uvcpad.ui.KeyBarPanel
            android:id="@+id/keyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/overlay_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- Speed: 1️⃣–5️⃣ cycle (SpeedLevel, writes prefs "speed_level", updates viewListener.mouseSpeed/scrollSpeed) -->
            <TextView
                style="@style/KeyBarButton"
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="4️⃣"
                android:textSize="14sp" />

            <!-- Bluetooth: shows device name/status; tap to connect/disconnect; long-press → multi-device switch (showDeviceSwitcher) -->
            <TextView
                style="@style/KeyBarButton"
                android:id="@+id/btnBt"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="📡"
                android:textSize="14sp" />

            <!-- Auto-pair 🔗: toggles autoPairFlag + startAutoReconnect/stopAutoReconnect -->
            <TextView
                style="@style/KeyBarButton"
                android:id="@+id/btnAutoPair"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🔗"
                android:textSize="14sp" />

            <!-- Resolution: 16:9 ↔ 4:3 (reuses switchMode; button label follows currentMode) -->
            <TextView
                style="@style/KeyBarButton"
                android:id="@+id/btnMode"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="16:9"
                android:textSize="14sp" />

            <!-- Screenshot 📷: captureJpg() (including MediaStore import) -->
            <TextView
                style="@style/KeyBarButton"
                android:id="@+id/btnCapture"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="📷"
                android:textSize="14sp" />

            <!-- Flexible spacer: pushes the exit button to the far right (hdmi2mp convention), while letting the triangle (top-center)
                 sit above the spacer so it stays clickable to collapse when the key bar is expanded -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Exit ⏻: cleanup + finish (onDestroy → AUSBC clear() releases UVC) -->
            <TextView
                style="@style/KeyBarButton"
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="⏻"
                android:textSize="14sp" />
        </com.github.ifeel.uvcpad.ui.KeyBarPanel>

        <!-- Drop triangle: the only always-visible UI, top-center, hot area 48dp×48dp; event-exempt area (DESIGN §3.3)
             above the key bar (later XML view is dispatched first) → the triangle stays visible and can be toggled to collapse
             while the key bar is expanded -->
        <com.github.ifeel.uvcpad.ui.DropTriangleView
            android:id="@+id/dropTriangle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal" />
    </FrameLayout>

    <!-- Error/notification area (diagnostics): initially hidden; shown by showError() on errors.
         Kept from hdmi2mp verbatim (errorText is independent of the toolbar and does not disappear with the auto-hide timer, making it easy for the user to read/photograph) -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="60dp"
        android:background="@color/error_bg"
        android:maxHeight="180dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:scrollbarStyle="insideOverlay"
        android:textColor="@color/error_red"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
