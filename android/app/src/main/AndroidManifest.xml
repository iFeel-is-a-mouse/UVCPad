<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 显示链路：USB/UVC + 相机（hdmi2mp 原样） ============ -->
    <!-- USB Host (OTG) and UVC device permissions -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Screenshot saving (only Android 9 and below need external storage writes; 10+ uses MediaStore without permissions) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Camera runtime permission: merged declaration from the AUSBC library; required to open the MS2130 UVC; requested proactively at app startup -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ============ 触控链路：蓝牙 HID（KeysJoy 原样） ============ -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- neverForLocation: the app never derives location from Bluetooth scans (uvcpad does no
         scanning at all — HID uses only getProfileProxy/registerApp/connect), so on Android 12+
         BLUETOOTH_SCAN does not drag in the location permission (DESIGN §1.3) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- API≤30 发现设备；S+ 因 BLUETOOTH_SCAN 声明 neverForLocation 而豁免定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!-- 手势触觉反馈（ViewListener 使用） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 常亮（FLAG_KEEP_SCREEN_ON） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".UvcpadApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uvcpad">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launches the app automatically when a USB device is attached -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>

</manifest>
