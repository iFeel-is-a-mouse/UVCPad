<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Display path: USB/UVC + camera (kept verbatim from hdmi2mp) ============ -->
    <!-- USB Host (OTG) and UVC device permissions -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Screenshot saving (only Android 9 and below need external storage writes; 10+ uses MediaStore without permissions) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Camera runtime permission: merged declaration from the AUSBC library; required to open the MS2130 UVC; requested proactively at app startup -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- [uvcpad-fix-p3] The CAMERA permission implies a camera hardware requirement, but this app uses a UVC capture card (not the built-in camera):
         declaring camera as not required avoids the PermissionImpliesUnsupportedChromeOsHardware lint and Play hardware filtering -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- [uvcpad-fix-p2] The AUSBC library merge brings in RECORD_AUDIO (not needed by this app's AudioSource.NONE): explicitly removed -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />

    <!-- ============ Touch path: Bluetooth HID (kept verbatim from KeysJoy) ============ -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- neverForLocation: the app never derives location from Bluetooth scans (uvcpad does no
         scanning at all — HID uses only getProfileProxy/registerApp/connect), so on Android 12+
         BLUETOOTH_SCAN does not drag in the location permission (DESIGN §1.3) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- API≤30: device discovery; S+ exempt from location permission because BLUETOOTH_SCAN declares neverForLocation -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!-- Gesture haptic feedback (used by ViewListener) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keep screen on (FLAG_KEEP_SCREEN_ON) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".UvcpadApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uvcpad">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launches the app automatically when a USB device is attached -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>

</manifest>
