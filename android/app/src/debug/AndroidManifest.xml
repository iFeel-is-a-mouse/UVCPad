<?xml version="1.0" encoding="utf-8"?>
<!-- [uvcpad-t0] Debug-only diagnostics entry points.
     This manifest is merged into debug builds only; release builds never declare the receiver
     (and the DebugReceiver class itself lives in src/debug, so it is not even compiled). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- [uvcpad-t0] ExportedReceiver is suppressed, not fixed: the adb-injected intents
             (DEBUG_HUD / DEBUG_SELFTEST / DEBUG_GESTURE) must cross the app boundary, so the
             receiver cannot be non-exported — an external entry point is the whole point of the
             debug tooling. Guard rails: (1) this declaration exists only in the debug source
             set — the release manifest never contains it; (2) DebugReceiver.onReceive re-checks
             BuildConfig.DEBUG before doing anything, so a release build has no reachable
             receiver at all. -->
        <receiver
            android:name=".diag.DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.github.ifeel.uvcpad.DEBUG_HUD" />
                <action android:name="com.github.ifeel.uvcpad.DEBUG_SELFTEST" />
                <action android:name="com.github.ifeel.uvcpad.DEBUG_GESTURE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
